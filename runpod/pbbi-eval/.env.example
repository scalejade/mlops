# Secrets for the pbbi-eval pod. Copy to .env in this folder:
#   cp runpod/pbbi-eval/.env.example runpod/pbbi-eval/.env
# HF_TOKEN reads the private scalejade/ repos. VLLM_API_KEY guards the public proxy
# URL — a long random string; callers send it as `Authorization: Bearer <key>`.
HF_TOKEN=
VLLM_API_KEY=
