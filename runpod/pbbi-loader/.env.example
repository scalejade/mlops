# Secrets and pins for the pbbi-loader pod. Copy to .env in this folder:
#   cp runpod/pbbi-loader/.env.example runpod/pbbi-loader/.env
# .env is gitignored. Only this file is read for the ${VAR}s in values.yaml.

# Reads the private scalejade/ repos. Read access is enough.
HF_TOKEN=

# How `make volume-fill` gets in to check the download (~/.ssh/id_ed25519.pub).
SSH_PUBLIC_KEY=

# The base the endpoint serves, at the sha its model.config pins (MODEL_REVISION).
BOOT_MODEL=scalejade/qwen-sea-lion-v4.5-27b-pbbi
BOOT_REVISION=8d32a4b9c89c9272ae8d660792182da7950955a2

# Every endpoint's LoRA adapter, "repo@tag", comma-separated. Each tag must equal
# that endpoint's ADAPTER_REVISION (runpod/pbbi-serverless-<task>/.env).
# Add the analysis adapter once it is trained:
#   BOOT_ADAPTERS=scalejade/pbbi-clause-extraction-lora@v0.1.0,scalejade/pbbi-analysis-lora@v0.1.0
BOOT_ADAPTERS=scalejade/pbbi-clause-extraction-lora@v0.1.0
