# Secrets for the pbbi-training pod. Copy to .env in this folder and fill it in:
#   cp runpod/pbbi-training/.env.example runpod/pbbi-training/.env
# .env is gitignored. Only this file is read for the ${VAR}s in values.yaml —
# not the root .env — and every value here is sent to the pod's environment.

# Pulls the private base model (scalejade/qwen-sea-lion-v4.5-27b-pbbi) and pushes
# the adapter. Needs write access to scalejade/pbbi-clause-extraction-lora.
HF_TOKEN=

# How ssh gets in. Without it `make train` cannot reach the pod.
# The contents of ~/.ssh/id_ed25519.pub (the public half, one line).
SSH_PUBLIC_KEY=

# Optional — no key, no experiment tracking.
WANDB_API_KEY=
WANDB_PROJECT=pbbi-mlops
