# Secrets for the pbbi-serverless-extraction endpoint. Copy to .env in this folder and fill it in:
#   cp runpod/pbbi-serverless-extraction/.env.example runpod/pbbi-serverless-extraction/.env
# .env is gitignored. Only this file is read for the ${VAR}s in values.yaml and in
# the models/<model>/model.config this chart deploys — not the root .env — and the
# values land in the endpoint's template env on RunPod.

# Lets the workers pull the private scalejade/ weights. Read access is enough:
# a serving token should not be able to write to the model repos.
HF_TOKEN=

# What the endpoint serves: a directory under models/ (its model.config holds the
# vLLM engine args, including MODEL_NAME, the Hub repo the workers pull).
#   qwen-sea-lion-v4.5-27b-pbbi     the PBBI training base — the adapter below fits only this
#   qwen-sea-lion-v4-32b-it         what the endpoint served before the adapter
#   gemma-4-31B-it                  the Gemma baseline
MODEL=qwen-sea-lion-v4.5-27b-pbbi

# The adapter's tag on scalejade/pbbi-clause-extraction-lora (values.yaml adapter:).
# Must equal this adapter's entry in BOOT_ADAPTERS, runpod/pbbi-loader/.env — that is the copy
# `make volume-fill` put on the volume, and the only one the workers can read.
ADAPTER_REVISION=v0.1.0
