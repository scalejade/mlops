# Secrets for the pbbi-serverles endpoint. Copy to .env in this folder and fill it in:
#   cp runpod/pbbi-serverles/.env.example runpod/pbbi-serverles/.env
# .env is gitignored. Only this file is read for the ${VAR}s in values.yaml and in
# the models/<model>/model.config this chart deploys — not the root .env — and the
# values land in the endpoint's template env on RunPod.

# Lets the workers pull the private scalejade/ weights. Read access is enough:
# a serving token should not be able to write to the model repos.
HF_TOKEN=
