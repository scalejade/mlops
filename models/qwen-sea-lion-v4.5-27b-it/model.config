MODEL_NAME=aisingapore/Qwen-SEA-LION-v4.5-27B-IT   # mirror is broken — see README
TOKENIZER_MODE=auto
SKIP_TOKENIZER_INIT=false
TRUST_REMOTE_CODE=false
LOAD_FORMAT=auto
DTYPE=auto
KV_CACHE_DTYPE=fp8
MAX_MODEL_LEN=262144
DISTRIBUTED_EXECUTOR_BACKEND=mp
RAY_WORKERS_USE_NSIGHT=false
PIPELINE_PARALLEL_SIZE=1
TENSOR_PARALLEL_SIZE=1
MAX_PARALLEL_LOADING_WORKERS=4
ENABLE_PREFIX_CACHING=true
DISABLE_SLIDING_WINDOW=false
SEED=0
MAX_NUM_SEQS=2
MAX_LOGPROBS=20
DISABLE_LOG_STATS=false
QUANTIZATION=None
ENABLE_LORA=false
MAX_LORAS=1
MAX_LORA_RANK=16
LORA_DTYPE=auto
MAX_CPU_LORAS=0
FULLY_SHARDED_LORAS=false
DEVICE=auto
SCHEDULER_DELAY_FACTOR=0
ENABLE_CHUNKED_PREFILL=true
MAX_NUM_BATCHED_TOKENS=8192
NUM_SPECULATIVE_TOKENS=0
NGRAM_PROMPT_LOOKUP_MAX=0
ENABLE_LOG_REQUESTS=false
GPU_MEMORY_UTILIZATION=0.90
BLOCK_SIZE=16
ENFORCE_EAGER=false
DISABLE_CUSTOM_ALL_REDUCE=false
DEFAULT_BATCH_SIZE=50
DEFAULT_MIN_BATCH_SIZE=1
DEFAULT_BATCH_SIZE_GROWTH_FACTOR=3
RAW_OPENAI_OUTPUT=true
OPENAI_RESPONSE_ROLE=assistant
MAX_CONCURRENCY=4
ENABLE_EXPERT_PARALLEL=false
BASE_PATH=/runpod-volume
ENABLE_AUTO_TOOL_CHOICE=false
PYTORCH_ALLOC_CONF=expandable_segments:True
VLLM_USE_DEEP_GEMM=0
HF_XET_HIGH_PERFORMANCE=1
HF_HOME=/runpod-volume/hf
HF_TOKEN=${HF_TOKEN}   # injected at deploy time — never commit a real token