# --- Secrets -----------------------------------------------------------------
.env
!.env.example
runpod.txt
*.pem
*.key

# --- Model weights -----------------------------------------------------------
# Weights live on the Hub, never in git. Model cards and configs ARE tracked.
models/**/weights/
*.safetensors
*.bin
*.gguf
*.pt
*.pth

# --- Training artifacts ------------------------------------------------------
training/adapters/**
!training/adapters/.gitkeep
wandb/
outputs/
checkpoints/

# --- Data --------------------------------------------------------------------
# Client documents and real datasets go to private HF dataset repos, not here.
eval/golden/**/expected/
# Raw client contracts (bank NDAs): one folder per document, PDF + xlsx +
# annotation.txt. Source material for build.py, never committed.
preparation/raw/
# build.py output: every row embeds a client contract, and build-report.json
# lists section headings lifted from them. Only the truncated sample is tracked.
preparation/data/*
!preparation/data/sample.jsonl

# --- Scratch -----------------------------------------------------------------
scratch/**
!scratch/.gitkeep
tmp/

# --- Python ------------------------------------------------------------------
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/

# --- OS ----------------------------------------------------------------------
.DS_Store

# --- Generated requests ------------------------------------------------------
# These embed client documents. Never commit them.
runpod/requests/**

# --- Clause-level comparisons -------------------------------------------------
# compare_runs.py workbooks quote the client contracts word for word. The md/csv/pdf
# reports beside them hold scores and bank names only, and ARE tracked.
docs/pbbi/reports/*.xlsx
