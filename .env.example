# Copy to .env and fill in. Never commit .env.

# Hugging Face credentials
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Namespace we clone models into
HF_NAMESPACE=scalejade

# Model to pull from the Hub
SOURCE_MODEL=google/gemma-4-31B-it-qat-w4a16-ct
SOURCE_REVISION=main

# Our name for it: models/<TARGET_MODEL> locally, <HF_NAMESPACE>/<TARGET_MODEL> on the Hub
TARGET_MODEL=gemma-4-31B-it-baseline

# Visibility of the cloned repo: private | public
VISIBILITY=private

# Where weights land if they are ever staged on disk
MODELS_DIR=models

# RunPod
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=

# Weights & Biases (experiment tracking)
WANDB_API_KEY=
WANDB_PROJECT=scalejade-mlops

# Network volume ids are NOT set here. runpod/deploy.py resolves them by name
# through the dependency declared in each chart.yaml.

# Endpoint to send requests to (printed by runpod/deploy.py apply)
RUNPOD_ENDPOINT_ID=

# vLLM server API key for pods (the pod proxy URL is public — set a real random value)
VLLM_API_KEY=

# SSH public key, for shelling into a pod when the engine refuses to boot
SSH_PUBLIC_KEY=
