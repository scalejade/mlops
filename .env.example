# Copy to .env and fill in. Never commit .env.

# Hugging Face — this laptop's token: make data (private tokenizer), clone scripts
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Namespace we clone models into
HF_NAMESPACE=scalejade

# Model to pull from the Hub
SOURCE_MODEL=google/gemma-4-31B-it-qat-w4a16-ct
SOURCE_REVISION=main

# Our name for it: models/<TARGET_MODEL> locally, <HF_NAMESPACE>/<TARGET_MODEL> on the Hub
TARGET_MODEL=gemma-4-31B-it-baseline

# Visibility of the cloned repo: private | public
VISIBILITY=private

# Where weights land if they are ever staged on disk
MODELS_DIR=models

# RunPod — this laptop's key, used to call the API. Never sent to RunPod.
RUNPOD_API_KEY=

# Endpoint to send requests to (printed by runpod/deploy.py apply)
RUNPOD_ENDPOINT_ID=

# Secrets that a pod or endpoint receives are NOT here. Each chart keeps its own,
# next to it, and its ${VAR}s resolve from that file only:
#   runpod/pbbi-training/.env    HF_TOKEN, SSH_PUBLIC_KEY, WANDB_API_KEY
#   runpod/pbbi-serverless-extraction/.env   HF_TOKEN
# Each folder has a .env.example to copy. The HF_TOKEN above is this laptop's
# (make data, scripts/clone_model.py) and is never sent to RunPod.
#
# Network volume ids are not set anywhere: runpod/deploy.py resolves them by name
# through the dependency declared in each chart.yaml.
